<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_demand_planning_to_be" targetNamespace="http://larkfield/bpmn" exporter="bpmnlay" exporterVersion="1.0">
  <bpmn:dataStore id="DataStore_1" name="ERP sales history" />
  <bpmn:dataStore id="DataStore_2" name="Decision log" />
  <bpmn:dataStore id="DataStore_3" name="Stock levels" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_main" name="Larkfield Dental Group" processRef="Process_demand_planning_to_be" />
    <bpmn:participant id="Participant_practice" name="Dental practices &amp; distributors" />
    <bpmn:participant id="Participant_supplier" name="Component suppliers" />
    <bpmn:messageFlow id="MessageFlow_1" name="Orders" sourceRef="Participant_practice" targetRef="Task_report" />
    <bpmn:messageFlow id="MessageFlow_2" name="Deliveries" sourceRef="Participant_supplier" targetRef="Task_execute" />
  </bpmn:collaboration>
  <bpmn:process id="Process_demand_planning_to_be" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Finance">
        <bpmn:flowNodeRef>StartEvent_cycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_bands</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Analytics platform">
        <bpmn:flowNodeRef>Task_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_explain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_forecast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_recommend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Demand Planning">
        <bpmn:flowNodeRef>Task_screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_band</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Sales">
        <bpmn:flowNodeRef>Task_decide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Supply Chain &amp; Production">
        <bpmn:flowNodeRef>Task_execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_released</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_cycle" name="Monthly cycle starts">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_bands" name="Set the budget limits and bands">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_1">
        <bpmn:targetRef>Data_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_report" name="Report last month's accuracy">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:property id="Property_Task_report" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Data_2">
        <bpmn:sourceRef>Data_2</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_report</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_3">
        <bpmn:targetRef>Data_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_explain" name="Explain the biggest deviations">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_forecast" name="Forecast demand and supplier risk">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:property id="Property_Task_forecast" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Data_4">
        <bpmn:sourceRef>Data_4</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_forecast</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_5">
        <bpmn:targetRef>Data_5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_recommend" name="Recommend an action per family">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_6">
        <bpmn:targetRef>Data_6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_screen" name="Check each action against its band">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_7">
        <bpmn:targetRef>Data_7</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_band" name="Inside the agreed band?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_decide" name="Approve or change, and record why">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_8">
        <bpmn:targetRef>Data_8</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_execute" name="Order materials and schedule production">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:property id="Property_Task_execute" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Data_9">
        <bpmn:sourceRef>Data_9</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_execute</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_10">
        <bpmn:targetRef>Data_10</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_released" name="Plan released and logged">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_Data_1" />
    <bpmn:dataObjectReference id="Data_1" name="Agreed tolerance bands" dataObjectRef="DataObject_Data_1" />
    <bpmn:dataStoreReference id="Data_2" name="ERP sales history" dataStoreRef="DataStore_1" />
    <bpmn:dataObject id="DataObject_Data_3" />
    <bpmn:dataObjectReference id="Data_3" name="Accuracy and service report" dataObjectRef="DataObject_Data_3" />
    <bpmn:dataStoreReference id="Data_4" name="Decision log" dataStoreRef="DataStore_2" />
    <bpmn:dataObject id="DataObject_Data_5" />
    <bpmn:dataObjectReference id="Data_5" name="Forecast and risk scores" dataObjectRef="DataObject_Data_5" />
    <bpmn:dataObject id="DataObject_Data_6" />
    <bpmn:dataObjectReference id="Data_6" name="Recommended actions" dataObjectRef="DataObject_Data_6" />
    <bpmn:dataObject id="DataObject_Data_7" />
    <bpmn:dataObjectReference id="Data_7" name="Exception list" dataObjectRef="DataObject_Data_7" />
    <bpmn:dataStoreReference id="Data_8" name="Decision log" dataStoreRef="DataStore_2" />
    <bpmn:dataStoreReference id="Data_9" name="Stock levels" dataStoreRef="DataStore_3" />
    <bpmn:dataObject id="DataObject_Data_10" />
    <bpmn:dataObjectReference id="Data_10" name="Purchase orders" dataObjectRef="DataObject_Data_10" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="StartEvent_cycle" targetRef="Task_bands" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="Task_bands" targetRef="Task_report" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="Task_report" targetRef="Task_explain" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="Task_explain" targetRef="Task_forecast" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="Task_forecast" targetRef="Task_recommend" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="Task_recommend" targetRef="Task_screen" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="Task_screen" targetRef="Gateway_band" />
    <bpmn:sequenceFlow id="Flow_8" name="yes" sourceRef="Gateway_band" targetRef="Task_execute" />
    <bpmn:sequenceFlow id="Flow_9" name="no" sourceRef="Gateway_band" targetRef="Task_decide" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="Task_decide" targetRef="Task_execute" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="Task_execute" targetRef="EndEvent_released" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
