<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_demand_planning_as_is" targetNamespace="http://dentalpro/bpmn" exporter="bpmnlay" exporterVersion="1.0">
  <bpmn:dataStore id="DataStore_1" name="ERP sales history" />
  <bpmn:dataStore id="DataStore_2" name="Annual revenue budget" />
  <bpmn:dataStore id="DataStore_3" name="Stock levels" />
  <bpmn:dataStore id="DataStore_4" name="Actual sales" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_main" name="Larkfield Dental Group" processRef="Process_demand_planning_as_is" />
    <bpmn:participant id="Participant_practice" name="Dental practices &amp; distributors" />
    <bpmn:participant id="Participant_supplier" name="Component suppliers" />
    <bpmn:messageFlow id="MessageFlow_1" name="Orders" sourceRef="Participant_practice" targetRef="Task_history" />
    <bpmn:messageFlow id="MessageFlow_2" name="Deliveries" sourceRef="Participant_supplier" targetRef="Task_order" />
  </bpmn:collaboration>
  <bpmn:process id="Process_demand_planning_as_is" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Sales">
        <bpmn:flowNodeRef>Task_regional</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Demand Planning">
        <bpmn:flowNodeRef>StartEvent_cycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_history</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_deviation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_accuracy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_planned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Finance">
        <bpmn:flowNodeRef>Task_budget_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_budget</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Supply Chain &amp; Production">
        <bpmn:flowNodeRef>Task_release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_order</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_cycle" name="Monthly cycle starts">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_history" name="Calculate draft forecast from sales history">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:property id="Property_Task_history" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Data_1">
        <bpmn:sourceRef>Data_1</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_history</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_2">
        <bpmn:targetRef>Data_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_regional" name="Adjust the draft for each market">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_3">
        <bpmn:targetRef>Data_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_merge" name="Merge the sheets into one plan">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_4">
        <bpmn:targetRef>Data_4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_compare" name="Compare the combined plan against the draft">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_5">
        <bpmn:targetRef>Data_5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_deviation" name="More than 15% away from the draft?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_meeting" name="Monthly meeting agrees the final numbers">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_6">
        <bpmn:targetRef>Data_6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_budget_check" name="Check the plan against the annual budget">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:property id="Property_Task_budget_check" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Data_7">
        <bpmn:sourceRef>Data_7</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_budget_check</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_8">
        <bpmn:targetRef>Data_8</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_budget" name="Fits the annual budget?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_release" name="Approve and release the plan">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_9">
        <bpmn:targetRef>Data_9</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_order" name="Order materials and schedule production">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:property id="Property_Task_order" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Data_10">
        <bpmn:sourceRef>Data_10</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_order</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_11">
        <bpmn:targetRef>Data_11</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_accuracy" name="Compare forecast with what actually sold">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:property id="Property_Task_accuracy" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Data_12">
        <bpmn:sourceRef>Data_12</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_accuracy</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Data_13">
        <bpmn:targetRef>Data_13</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_planned" name="Plan in production">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="Data_1" name="ERP sales history" dataStoreRef="DataStore_1" />
    <bpmn:dataObject id="DataObject_Data_2" />
    <bpmn:dataObjectReference id="Data_2" name="Draft forecast" dataObjectRef="DataObject_Data_2" />
    <bpmn:dataObject id="DataObject_Data_3" />
    <bpmn:dataObjectReference id="Data_3" name="Eight regional sheets" dataObjectRef="DataObject_Data_3" />
    <bpmn:dataObject id="DataObject_Data_4" />
    <bpmn:dataObjectReference id="Data_4" name="Combined forecast" dataObjectRef="DataObject_Data_4" />
    <bpmn:dataObject id="DataObject_Data_5" />
    <bpmn:dataObjectReference id="Data_5" name="List of big differences" dataObjectRef="DataObject_Data_5" />
    <bpmn:dataObject id="DataObject_Data_6" />
    <bpmn:dataObjectReference id="Data_6" name="Agreed forecast" dataObjectRef="DataObject_Data_6" />
    <bpmn:dataStoreReference id="Data_7" name="Annual revenue budget" dataStoreRef="DataStore_2" />
    <bpmn:dataObject id="DataObject_Data_8" />
    <bpmn:dataObjectReference id="Data_8" name="Budget variance note" dataObjectRef="DataObject_Data_8" />
    <bpmn:dataObject id="DataObject_Data_9" />
    <bpmn:dataObjectReference id="Data_9" name="Released demand plan" dataObjectRef="DataObject_Data_9" />
    <bpmn:dataStoreReference id="Data_10" name="Stock levels" dataStoreRef="DataStore_3" />
    <bpmn:dataObject id="DataObject_Data_11" />
    <bpmn:dataObjectReference id="Data_11" name="Purchase orders" dataObjectRef="DataObject_Data_11" />
    <bpmn:dataStoreReference id="Data_12" name="Actual sales" dataStoreRef="DataStore_4" />
    <bpmn:dataObject id="DataObject_Data_13" />
    <bpmn:dataObjectReference id="Data_13" name="Accuracy sheet" dataObjectRef="DataObject_Data_13" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="StartEvent_cycle" targetRef="Task_history" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="Task_history" targetRef="Task_regional" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="Task_regional" targetRef="Task_merge" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="Task_merge" targetRef="Task_compare" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="Task_compare" targetRef="Gateway_deviation" />
    <bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gateway_deviation" targetRef="Task_meeting" />
    <bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gateway_deviation" targetRef="Task_budget_check" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="Task_meeting" targetRef="Task_budget_check" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="Task_budget_check" targetRef="Gateway_budget" />
    <bpmn:sequenceFlow id="Flow_10" name="yes" sourceRef="Gateway_budget" targetRef="Task_release" />
    <bpmn:sequenceFlow id="Flow_11" name="no" sourceRef="Gateway_budget" targetRef="Task_meeting" />
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="Task_release" targetRef="Task_order" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="Task_order" targetRef="Task_accuracy" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="Task_accuracy" targetRef="EndEvent_planned" />
  </bpmn:process>
